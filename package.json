{
  "name": "roaring-steel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "build-bulma": "sass --load-path=node_modules src/assets/roaring-steel.scss src/assets/roaring-steel.css",
    "start": "npm run build-bulma -- --watch"
  },
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.19.0",
    "@turf/turf": "^7.3.1",
    "@vueuse/core": "^14.1.0",
    "bulma": "^1.0.4",
    "leaflet": "^1.9.4",
    "leaflet-textpath": "^1.3.0",
    "lz-string": "^1.5.0",
    "papaparse": "^5.5.3",
    "pinia": "^2.3.1",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.5",
    "@rushstack/eslint-patch": "^1.15.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.6.2",
    "happy-dom": "^20.0.11",
    "prettier": "^3.7.4",
    "sass": "^1.97.1",
    "vite": "^7.3.0",
    "vite-plugin-vue-devtools": "^7.7.9",
    "vitest": "^4.0.16"
  }
}
