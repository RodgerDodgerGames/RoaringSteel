{
  "name": "roaring-steel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "test": "vitest",
    "build-bulma": "sass --load-path=node_modules src/assets/roaring-steel.scss src/assets/roaring-steel.css",
  "start": "npm run build-bulma -- --watch"
  },
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.17.0",
    "@turf/turf": "^7.1.0",
    "@vueuse/core": "^11.1.0",
    "bulma": "^1.0.2",
    "leaflet": "^1.9.4",
    "papaparse": "^5.4.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.24.1",
    "@rushstack/eslint-patch": "^1.3.3",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/eslint-config-prettier": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^9.24.0",
    "prettier": "^3.2.5",
    "sass": "^1.80.4",
    "vite": "^5.1.6",
    "vite-plugin-vue-devtools": "^7.0.18",
    "vitest": "^1.4.0"
  }
}
