{
  "name": "roaring-steel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "build-bulma": "sass --load-path=node_modules src/assets/roaring-steel.scss src/assets/roaring-steel.css",
    "start": "npm run build-bulma -- --watch"
  },
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.20.0",
    "@turf/turf": "^7.4.0",
    "@vueuse/core": "^14.4.0",
    "bulma": "^1.0.4",
    "leaflet": "^1.9.4",
    "leaflet-textpath": "^1.3.0",
    "lz-string": "^1.5.0",
    "papaparse": "^5.7.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@rushstack/eslint-patch": "^1.16.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.13.2",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
